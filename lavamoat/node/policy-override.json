{
  "resources": {
    "depd": {
      "globals": {
        "Error.prepareStackTrace": "write",
        "Error.captureStackTrace": true,
        "Error.stackTraceLimit": "write"
      }
    },

    "axios": {
      "globals": {
        "document": false,
        "importScripts": false,
        "location.href": false,
        "navigator": false,
        "WorkerGlobalScope": false,
        "XMLHttpRequest": false
      }
    },

    "morgan>debug": {
      "globals": {
        "chrome": false,
        "document": false,
        "localStorage": false,
        "navigator": false
      }
    },

    "winston": {
      "builtin": {
        "http": false,
        "https": false
      },
      "globals": {
        "process.exit": false
      }
    },

    "@hathor/ct-crypto-node": {
      "packages": {
        "@hathor/ct-crypto-node>@hathor/ct-crypto-node-linux-arm64-musl": true,
        "@hathor/ct-crypto-node>@hathor/ct-crypto-node-linux-x64-musl": true
      }
    },

    "@hathor/ct-crypto-node>@hathor/ct-crypto-node-linux-arm64-musl": {
      "native": true
    },

    "@hathor/ct-crypto-node>@hathor/ct-crypto-node-linux-x64-musl": {
      "native": true
    }
  }
}
